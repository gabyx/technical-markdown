% % Start: header.tex =======================================

%% Geometry ==========================================
\usepackage[]{geometry}
% ====================================================

%% Graphics ==========================================
\usepackage{graphicx}
\usepackage{tikz}
\usepackage[]{adjustbox}
\usepackage[]{pdfpages}
\usepackage{wrapfig}
\usepackage[]{placeins} % float barrier at each section
\usepackage{svg}
% ====================================================

% Set include paths ==================================
\makeatletter
\providecommand*{\input@path}{}
\edef\input@path{$for(latex-include-paths)${$latex-include-paths$}$endfor${./}\input@path}% prepend
\makeatother
\svgsetup{extractpath=files/generated/svg-extract,inkscapepath=files/generated/svg-inkscape}
% ====================================================

%% Caption ===========================================
\usepackage[]{caption}
\DeclareCaptionStyle{figcaption}{
    justification=justified,
    font={normal},
    labelfont=bf,
    belowskip=-5pt
}

\DeclareCaptionStyle{tablecaption}{
    justification=justified,
    font={normal},
    labelfont=bf,
    belowskip=5pt
}

\usepackage[]{subcaption}
\captionsetup[figure]{style=figcaption}
\captionsetup[table]{style=tablecaption}
\captionsetup[longtable]{style=tablecaption}
% ====================================================

%% Header/Footer =====================================
\usepackage[]{scrlayer-scrpage}
\clearpairofpagestyles
\setkomafont{pagehead}{\normalfont\rmfamily\bfseries}
%\setkomafont{pagenumber}{\normalfont\rmfamily}

\automark[chapter]{chapter}
\renewcommand{\chaptermarkformat}{}
\renewcommand{\sectionmarkformat}{\thesection\autodot\enskip}
\cfoot[\pagemark]{\pagemark}
\lehead{Chapter \thechapter}
\rohead{\headmark}
\rehead{}
\lohead{}

% Footnotes
\usepackage[]{footmisc}
% ====================================================

%% Enumitems =========================================
\usepackage{enumitem}
\setlist[description,1]{leftmargin=0.5cm,font=\rmfamily}

%% Tables ============================================
\usepackage{array}
\usepackage{longtable}
\usepackage{booktabs}
\usepackage{collcell}
\usepackage{makecell}
\usepackage{footnotehyper}
\usepackage{tablefootnote}
\AtBeginEnvironment{longtable}{%
\setlist[itemize]{nosep=0pt,
                 leftmargin=*,
                 label=\textbullet,
                 after=\end{minipage},
                 before=\begin{minipage}[t]{\linewidth}
}
}

% Define default table spacing...
\usepackage{cellspace}
\setlength{\cellspacetoplimit}{0.2\baselineskip}
\setlength{\cellspacebottomlimit}{0.2\baselineskip}
% ====================================================

%% Quotes =============================================
\usepackage[]{quoting}

