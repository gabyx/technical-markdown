$passoptions.latex()$
\documentclass[
$for(babel-otherlangs)$
  $babel-otherlangs$,
$endfor$
$if(babel-lang)$
  $babel-lang$,
$endif$
$if(fontsize)$
  $fontsize$,
$endif$
$if(papersize)$
  $papersize$paper,
$endif$
$for(classoption)$
  $classoption$$sep$,
$endfor$
]{$documentclass$}
%
$header.latex()$
$fonts.latex()$
$pandoc-common.latex()$
$hypersetup.latex()$
$title-settings.latex()$
$macros.latex()$
%
\begin{document}
%
$if(has-frontmatter)$
\frontmatter
$endif$
%
$if(title)$
$title.latex()$
$endif$
%
$frontmatter-settings.latex()$
%
$if(abstract)$
$abstract.latex()$
$endif$
%
$if(acknowledgement)$
$acknowledgement.latex()$
$endif$
%
$for(include-before)$
$include-before$

$endfor$
%
$if(toc)$
$toc.latex()$
$endif$
%
$if(has-frontmatter)$
\mainmatter
$endif$
$mainmatter-settings.latex()$
$body$
%
$if(has-frontmatter)$
\backmatter
$backmatter-settings.latex()$
$endif$
%
$lists.latex()$
%
$bibliography.latex()$
%
$for(include-after)$
$include-after$

$endfor$
\end{document}
