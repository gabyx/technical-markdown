  //
  // These tasks drive the `just` recipes defined in the root `justfile`.
  // Run them via "Terminal → Run Task…" (or Ctrl/Cmd+Shift+B for the default build).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🛠️ Build HTML",
      "detail": "just build html",
      "type": "shell",
      "command": "just",
      "args": ["build", "html"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "group": "build"
      }
    },
    {
      "label": "🛠️ Build PDF",
      "detail": "just build pdf",
      "type": "shell",
      "command": "just",
      "args": ["build", "pdf"],
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "group": "build"
      }
    },
    {
      "label": "🛠️ Build LaTeX",
      "detail": "just build latex",
      "type": "shell",
      "command": "just",
      "args": ["build", "latex"],
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "group": "build"
      }
    },
    {
      "label": "🛠️ Build JSON",
      "detail": "just build json",
      "type": "shell",
      "command": "just",
      "args": ["build", "json"],
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "group": "build"
      }
    },
    {
      "label": "🛠️ Build native",
      "detail": "just build native",
      "type": "shell",
      "command": "just",
      "args": ["build", "native"],
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "group": "build"
      }
    },
    {
      "label": "🛠️ Build HTML + PDF",
      "detail": "just build html && just build pdf",
      "dependsOn": ["🛠️ Build HTML", "🛠️ Build PDF"],
      "dependsOrder": "sequence",
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "group": "build"
      }
    },
    {
      "label": "🌐 Serve",
      "detail": "just serve — run the markdown render services (long-running)",
      "type": "shell",
      "command": "just",
      "args": ["serve"],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "group": "build",
        "reveal": "always"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "✨ Format",
      "detail": "just format — run treefmt over the project",
      "type": "shell",
      "command": "just",
      "args": ["format"],
      "problemMatcher": [],
      "presentation": {
        "panel": "shared",
        "group": "maintenance"
      }
    },
    {
      "label": "🧹 Clean",
      "detail": "just clean — remove the .output directory",
      "type": "shell",
      "command": "just",
      "args": ["clean"],
      "problemMatcher": [],
      "presentation": {
        "panel": "shared",
        "group": "maintenance"
      }
    }
  ]
}
